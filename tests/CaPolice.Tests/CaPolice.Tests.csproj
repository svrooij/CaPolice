<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.70.1" />
  </ItemGroup>

  <!-- Build-ordering only: the assembly isolation tests spawn pwsh and import the built
       CaPolice module from bin/Release/net8.0. Referencing the project (without consuming
       its output assembly, since it targets a different TFM) guarantees the module is built
       before these tests run. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\CaPolice\CaPolice.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

</Project>
